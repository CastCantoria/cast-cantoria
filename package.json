{
  "name": "sanctum-vox",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node api/server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:api\"",
    "build": "vite build",
    "build:api": "echo \"✅ Aucun build nécessaire pour Express\"",
    "build:all": "npm run build && npm run build:api",
    "preview": "vite preview",
    "start": "npm run preview",
    "lint": "npx vue-tsc --noEmit && npx eslint . --ext .vue,.js,.ts",
    "format": "npx prettier --write .",
    "clean": "powershell -Command \"Remove-Item -Recurse -Force dist, .firebase; Write-Host '🧹 Nettoyage terminé'\"",
    "deploy:vercel": "echo \"🚀 Déploiement géré automatiquement par Vercel\"",
    "deploy:firebase": "firebase deploy --only hosting,functions"
  },
  "dependencies": {
    "@vueuse/core": "^13.9.0",
    "cors": "^2.8.5",
    "express": "4.18.2",
    "express-validator": "^7.2.1",
    "firebase": "^12.2.1",
    "firebase-admin": "^13.5.0",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "swiper": "^11.2.10",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^8.56.0",
    "prettier": "^3.1.0",
    "vite": "^7.1.2",
    "vue-tsc": "^1.8.23"
  }
}